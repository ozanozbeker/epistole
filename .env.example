# Copy to .env, then run: uv run --env-file .env pytest tests/test_live_*.py --tb=short
ICLOUD_ADDRESS=you@icloud.com
# Use an app-specific password from account.apple.com, not the Apple Account password.
ICLOUD_APP_PASSWORD=abcd-efgh-ijkl-mnop
# Set to an iCloud+ custom-domain address on the same account, or leave empty to skip that test.
ICLOUD_CUSTOM_ADDRESS=you@example.com
GMAIL_ADDRESS=you@gmail.com
# Turn on 2-Step Verification at https://myaccount.google.com/security, then create one under App passwords.
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
# Point to a saved consent that grants gmail.send and https://mail.google.com/. To save one, see https://ozanozbeker.com/epistole/user-guide/mail-services.html#with-your-own-oauth-client
GMAIL_AUTHORIZED_USER=~/.config/epistole/gmail-authorized-user.json
